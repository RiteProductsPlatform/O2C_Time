{
  "description": "First-time password setup for an Invited account, and self-service change for an Active one. Reachable without a session, which is the point — an Invited user has no way to sign in until they have been here.",
  "variables": {
    "email": {
      "type": "string",
      "defaultValue": "",
      "input": "fromUrl",
      "description": "Passed in from the login page so a user who has just typed their address does not type it twice."
    },
    "currentPassword": {
      "type": "string",
      "defaultValue": ""
    },
    "newPassword": {
      "type": "string",
      "defaultValue": ""
    },
    "confirmPassword": {
      "type": "string",
      "defaultValue": ""
    },
    "errorMessage": {
      "type": "string",
      "defaultValue": "",
      "input": "none"
    },
    "successMessage": {
      "type": "string",
      "defaultValue": "",
      "input": "none"
    },
    "isSaving": {
      "type": "boolean",
      "defaultValue": false,
      "input": "none"
    }
  },
  "types": {},
  "chains": {},
  "eventListeners": {
    "doSetPassword": {
      "chains": [
        {
          "chain": "setPasswordChain",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "goToLogin": {
      "chains": [
        {
          "chain": "goToLoginChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-input-password": {
        "path": "ojs/ojinputpassword"
      },
      "oj-bind-if": {
        "path": "ojs/ojbindif"
      },
      "oj-bind-text": {
        "path": "ojs/ojbindtext"
      }
    }
  },
  "translations": {}
}

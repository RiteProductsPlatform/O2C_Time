{
  "description": "O2C Timesheet shell — topbar with the period and acting-manager context, the RBAC sidebar (RULE-022), the app-wide messages banner and toast, and the single router outlet that hosts the 'main' flow.",
  "routerFlow": "main",
  "variables": {
    "sidebarCollapsed": {
      "type": "boolean",
      "defaultValue": true,
      "input": "none",
      "description": "Push-layout sidebar state. A page variable rather than a DOM class toggle, so the markup stays declarative and the state survives a re-render. Starts closed, matching the main O2C application."
    },
    "shellError": {
      "type": "string",
      "defaultValue": "",
      "input": "none",
      "description": "Set only when the shell could not establish the signed-in identity — a dead session, an unreachable service. Page-level errors go to messagesBannerADP instead."
    },
    "messageToast": {
      "type": "string"
    },
    "messagesBannerADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "MessagesBannerType",
        "keyAttributes": "id"
      }
    },
    "messageId": {
      "type": "string",
      "defaultValue": "1",
      "description": "MUST have a defaultValue. Without one it starts undefined, arithmetic yields NaN, and the ADP can never match a key to remove — notifications would never dismiss."
    }
  },
  "metadata": {},
  "types": {
    "MessagesBannerType": {
      "id": "string",
      "messageType": "string",
      "primaryText": "string",
      "primaryActionLabel": "string",
      "secondaryText": "any",
      "secondaryActionLabel": "string"
    },
    "managerOptType": {
      "value": "string",
      "label": "string"
    }
  },
  "chains": {},
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "checkSessionChain"
        }
      ]
    },
    "navClick": {
      "chains": [
        {
          "chain": "navigateToPageChain",
          "parameters": {
            "page": "{{ $event.currentTarget.dataset.page }}"
          }
        }
      ]
    },
    "doLogout": {
      "chains": [
        {
          "chain": "logoutChain"
        }
      ]
    },
    "toggleSidebar": {
      "chains": [
        {
          "chain": "toggleSidebarChain"
        }
      ]
    },
    "application:spShowToast": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "showMessageToast"
        }
      ]
    },
    "messagesBannerSpClose": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "closeMessageBanner"
        }
      ]
    },
    "vbNotification": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "showNotificationMessage"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-pillar-theme": {
        "path": "oj-sp/pillar-theme/loader"
      },
      "oj-sp-messages-banner": {
        "path": "oj-sp/messages-banner/loader"
      },
      "oj-sp-messages-toast": {
        "path": "oj-sp/messages-toast/loader"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-bind-if": {
        "path": "ojs/ojbindif"
      },
      "oj-bind-text": {
        "path": "ojs/ojbindtext"
      },
      "oj-bind-for-each": {
        "path": "ojs/ojbindforeach"
      }
    }
  },
  "translations": {}
}

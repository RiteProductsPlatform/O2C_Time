  "services": {
    "oc_time": {
      "path": "./services/oc_time/service.json"
    },
    "fa_hcm": {
      "path": "./services/fa_hcm/service.json"
    }
  },
  "translations": {
    "appBundle": {
      "path": "./resources/strings/appBundle/nls/appBundle-strings"
    }
  },
  "types": {
    "lovOptionType": {
      "value": "string",
      "label": "string"
    },
    "periodOptionType": {
      "value": "number",
      "label": "string",
      "periodState": "string",
      "editableFlag": "string",
      "adjustmentAllowed": "string"
    }
  },
  "variables": {
    "isLoggedIn": {
      "type": "boolean",
      "defaultValue": false,
      "description": "The application signs users in itself against oc.time.auth rather than relying on the identity VB hands it, so that the common administrator - who need not be a worker in HCM - can get in. The shell hides its chrome while this is false."
    },
    "sessionToken": {
      "type": "string",
      "defaultValue": "",
      "description": "Bearer token from POST /oc/time/auth/login. Valid 24 hours; mirrored into localStorage so a refresh does not force a re-login."
    },
    "currentUserId": {
      "type": "number",
      "defaultValue": null,
      "description": "OC_TIME_USER.USER_ID. The login identity, distinct from employeeId - the common admin has one without the other."
    },
    "userName": {
      "type": "string",
      "defaultValue": "",
      "description": "Display name in the topbar. Same value as employeeName for worker logins."
    },
    "currentEmail": {
      "type": "string",
      "defaultValue": "",
      "description": "Signed-in user's email. Written to CREATED_BY / UPDATED_BY on every ORDS write so the audit trail names a real person (NFR-010)."
    },
    "employeeId": {
      "type": "string",
      "defaultValue": "",
      "description": "HCM PersonNumber of the signed-in worker. Every employee endpoint is keyed on this."
    },
    "employeeName": {
      "type": "string",
      "defaultValue": ""
    },
    "currentRole": {
      "type": "string",
      "defaultValue": "",
      "description": "APP_ROLE from OC_TIME_WORKER: ROLE_TIME_EMPLOYEE | ROLE_TIME_CONTRACTOR | ROLE_TIME_MANAGER | ROLE_TIME_ADMIN | ROLE_TIME_NONE. Drives the whole menu (RULE-022); ROLE_TIME_NONE gets an empty nav."
    },
    "managerEmpId": {
      "type": "string",
      "defaultValue": "",
      "description": "Reporting manager. RULE-015: a manager's own time is approved by THIS person, never by themselves."
    },
    "workerType": {
      "type": "string",
      "defaultValue": "Employee",
      "description": "Employee | Contractor. Contractor non-billable time raises the exception-approval flag (RULE-021)."
    },
    "stdHoursPerDay": {
      "type": "number",
      "defaultValue": 8,
      "description": "Standard hours per day for the worker's country of work (CFG-013)."
    },
    "totalAllocPct": {
      "type": "number",
      "defaultValue": 0,
      "description": "Sum of active allocation %. RULE-001 warns when this is not 100."
    },
    "actingManagerId": {
      "type": "string",
      "defaultValue": "",
      "description": "The manager whose team is being reviewed. Defaults to employeeId but a split employee reports into several managers, so the manager can switch (ACT-011). All approval calls send this as actorEmpId."
    },
    "openPeriodId": {
      "type": "number",
      "defaultValue": null,
      "description": "The single Open period (RULE-017)."
    },
    "selectedPeriodId": {
      "type": "number",
      "defaultValue": null,
      "description": "Period the user is working in. Shared by every page so navigation keeps context."
    },
    "selectedPeriodName": {
      "type": "string",
      "defaultValue": ""
    },
    "periodEditable": {
      "type": "string",
      "defaultValue": "N",
      "description": "Y when the selected period may still be edited (RULE-004 / RULE-007)."
    },
    "adjustmentAllowed": {
      "type": "string",
      "defaultValue": "N",
      "description": "Y when the selected period is closed but still inside the backdating window, so the retro adjustment card is offered (RULE-019)."
    },
    "selectedProjectId": {
      "type": "number",
      "defaultValue": null
    },
    "selectedProjectName": {
      "type": "string",
      "defaultValue": ""
    },
    "selectedEmployeeId": {
      "type": "string",
      "defaultValue": "",
      "description": "Employee the manager drilled into from the monthly summary."
    },
    "selectedEmployeeName": {
      "type": "string",
      "defaultValue": ""
    },
    "selectedWeekId": {
      "type": "number",
      "defaultValue": null,
      "description": "OC_TS_WEEK.TS_WEEK_ID currently open on the approval detail page."
    },
    "activeNav": {
      "type": "string",
      "defaultValue": "main-my-timesheet",
      "description": "Highlights the current item in the shell navigation list. Holds the page id inside the single 'main' flow."
    },
    "traceId": {
      "type": "string",
      "defaultValue": "",
      "description": "Correlation id sent on every write so a user action can be followed across VBCS -> ORDS -> OIC (OBS-001..008, NFR-011)."
    },
    "ordsBaseUrl": {
      "type": "string",
      "defaultValue": "https://ords-sit.rite.digital/ords/o2c_time",
      "description": "ORDS base for direct fetches (file download/upload) that do not go through callRest. Single place to change per environment; never a PROD URL in source."
    },
    "appDateFormat": {
      "type": "string",
      "defaultValue": "dd-MMM-yyyy"
    },
    "appDateDisplay": {
      "type": "string",
      "defaultValue": "DD-MON-YYYY"
    },
    "rejectReasonOptions": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "lovOptionType",
        "keyAttributes": "value",
        "data": [
          {
            "value": "Manager",
            "label": "Manager"
          },
          {
            "value": "Client",
            "label": "Client"
          },
          {
            "value": "Absence",
            "label": "Absence"
          }
        ]
      },
      "description": "FLD-057 / RULE-013. Static because the BRD fixes the three values."
    },
    "periodOptionsArray": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Raw month LOV rows. periodOptions is live-bound to this (the array-linked ADP pattern), so a chain assigns the array and every period selector updates."
    },
    "periodOptions": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "periodOptionType",
        "keyAttributes": "value",
        "data": []
      }
    }
  },
  "userConfig": {
    "type": "vb/DefaultSecurityProvider",
    "configuration": {},
    "embedding": "deny"
  },
  "//security": [
    "requiresAuthentication is FALSE on purpose, and it is not a relaxation.",
    "",
    "The module authenticates against its own OC_TIME_USER store through",
    "oc.time.auth, the same way the main O2C application does. If VB's own",
    "gate were on as well, the identity provider would decide who gets in and",
    "the app would only be able to look that person up - which is exactly the",
    "model that left the common administrator with no way to sign in, since",
    "they need not exist as a worker in HCM.",
    "",
    "Every page is still behind the login: the shell renders no navigation and",
    "no router outlet content until isLoggedIn is true, and every ORDS write",
    "carries the session token. Security sheet RBAC is enforced on the role",
    "resolved by V_OC_TIME_SIGNIN, not on anything the browser asserts."
  ],
  "security": {
    "access": {
      "requiresAuthentication": false
    }
  },
  "flows": {},
  "settings": {
    "stopValidationPreLoading": true
  },
  "events": {
    "sessionEstablished": {
      "description": "Fired once a session exists, by whichever path created it - the login form, or the shell restoring a stored token. The shell answers by loading the context every page depends on (the period list, the manager switcher). An event rather than a direct call because the login page lives in the 'main' flow and cannot reach the shell page's chains. NO payloadType: an empty map is rejected by VB at startup, and this event genuinely carries nothing."
    },
    "spShowToast": {
      "payloadType": {
        "message": "string"
      },
      "description": "Fire this event with an acknowledgement message to indicate to user that an operation was successful. The shell page will render the message using oj-sp-messages-toast component."
    }
  }
}
